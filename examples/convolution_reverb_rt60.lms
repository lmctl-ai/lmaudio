# Convolution reverb: build a hall impulse response, measure its RT60 the way acousticians do
# (Schroeder backward integration, ISO 3382 T30), then place a dry plucked melody in the hall.
# The impulse response is the direct sound, five early wall reflections (12-41 ms, the image-
# source delays sketched in the room plan) and an exponentially decaying noise tail with
# RT60 = 1.4 s, darkened by a 5 kHz low-pass like air absorption. Buffer.rt60() fits the
# -5..-35 dB part of the Schroeder curve and must recover 1.4 s (asserted to 5 %).
# Buffer.convolve does the FFT overlap-add convolution; a unit impulse leaves the signal
# unchanged (asserted).
# Writes images/convolution_reverb_rt60.png and audio/convolution_reverb_rt60.wav.
mkdir("build");
mkdir("build/rendered");
mkdir("images");
mkdir("audio");

a = _dsl_ cli="lmaudio" install="github:lmctl-ai/lmaudio@latest";
let sr = 22050;
let rt = 1.4;
let len = 2.4;

# Diffuse tail: noise x exp(-6.91 t / RT60), starting 20 ms after the direct sound.
let env = audio.expr("exp(-6.907755 * t / 1.4)", len - 0.02, sr);
let tail = audio.noise("white", len - 0.02, 0.12, 11, sr).multiply(env).biquad("lowpass", 5000.0, 0.7).pad(0.02, 0.0);
# Direct sound and early reflections (delay s, gain).
let ir = audio.impulse(len, 0.0, 1.0, sr).mix(tail);
ir = ir.mix(audio.impulse(0.05, 0.0, 0.55, sr), 1.0, 0.012);
ir = ir.mix(audio.impulse(0.05, 0.0, 0.45, sr), 1.0, 0.019);
ir = ir.mix(audio.impulse(0.05, 0.0, 0.38, sr), 1.0, 0.027);
ir = ir.mix(audio.impulse(0.05, 0.0, 0.30, sr), 1.0, 0.033);
ir = ir.mix(audio.impulse(0.05, 0.0, 0.24, sr), 1.0, 0.041);
ir = ir.slice(0.0, len);

let measured = ir.rt60();
audio.print("hall RT60: designed " + str(rt) + " s, measured from the Schroeder curve " + str(measured) + " s");
audio.assert_close(measured, rt, 0.05 * rt);

ir.slice(0.0, 0.3).save_csv("build/conv_ir_early.csv");
let edc = ir.schroeder_db();
edc.save_csv("build/conv_edc.csv", 1200);
# Time where the curve crosses -5 dB, for drawing the T30 fit line.
let t5 = 0.0;
let found = 0;
let n = 0;
while (found == 0 && n < edc.frames()) {
  if (edc.get(n) <= -5.0) {
    t5 = float(n) / float(sr);
    found = 1;
  }
  n = n + 4;
}
audio.save_text("build/conv_fit.gp", "t5 = " + str(t5) + "; rt = " + str(measured) + "\n");

# Identity check: convolving with a unit impulse returns the input.
let dry = audio.sequence("E4:0.5 G4:0.5 B4:0.5 E5:1 D5:0.5 B4:1", 150.0, "karplus", sr).slice(0.0, 1.5);
audio.assert_close(dry.convolve(audio.impulse(0.01, 0.0, 1.0, sr)).slice(0.0, 1.5).snr_db(dry), 240.0, 0.1);
let wet = dry.convolve(ir);
let mixdown = dry.pad(0.0, wet.duration() - dry.duration()).gain(0.7).mix(wet.normalize(0.7)).slice(0.0, 2.5);
dry.spectrogram(512, 128, "hann", 5000.0).save_csv("build/conv_dry_sg.csv", -80.0);
mixdown.spectrogram(512, 128, "hann", 5000.0).save_csv("build/conv_wet_sg.csv", -80.0);
dry.normalize(0.85).fade(0.0, 0.05).concat(audio.silence(0.2, sr)).concat(mixdown.normalize(0.85).fade(0.0, 0.4)).save_wav("audio/convolution_reverb_rt60.wav", 16);
end _dsl_
savedsl(a, "build/convolution_reverb_rt60.dslb");
r1 = system ${dsl_cli(a)} --dsl build/convolution_reverb_rt60.dslb;
for (l in lines(r1.stdout)) { if (!starts_with(l, "{")) { println(l); } }
if (r1.code != 0) { println(r1.stderr); }
assert(r1.code == 0);

d = _dsl_ cli="lmdraw" install="github:lmctl-ai/lmdraw@latest";
scene.canvas(460, 300, "#ffffff");
scene.text(230.0, 22.0, 15.0, "Hall plan: direct sound and image-source reflections", "#0f172a").set_attr("text-anchor", "middle");
scene.rect(40.0, 45.0, 380.0, 220.0, "#f8fafc").set_attr("stroke", "#334155").set_attr("stroke-width", "3");
# Source and listener
scene.circle(110.0, 180.0, 9.0, "#dc2626");
scene.text(110.0, 205.0, 12.0, "source", "#b91c1c").set_attr("text-anchor", "middle");
scene.circle(330.0, 150.0, 9.0, "#2563eb");
scene.text(352.0, 140.0, 12.0, "listener", "#1d4ed8").set_attr("text-anchor", "middle");
# Direct path
scene.arrow(119.0, 178.0, 320.0, 152.0, "#0f172a", 2.2);
scene.text(205.0, 157.0, 11.0, "direct, 0 ms", "#0f172a");
# Reflection off the top wall
scene.line(110.0, 180.0, 205.0, 45.0, "#f59e0b", 1.8).set_attr("stroke-dasharray", "5 3");
scene.arrow(205.0, 45.0, 324.0, 142.0, "#f59e0b", 1.8);
scene.text(215.0, 70.0, 11.0, "top wall, +12 ms", "#b45309");
# Reflection off the bottom wall (plan view)
scene.line(110.0, 180.0, 240.0, 265.0, "#16a34a", 1.8).set_attr("stroke-dasharray", "5 3");
scene.arrow(240.0, 265.0, 326.0, 159.0, "#16a34a", 1.8);
scene.text(120.0, 252.0, 11.0, "bottom wall, +19 ms", "#15803d");
# Reflection off the right wall
scene.line(110.0, 180.0, 420.0, 190.0, "#7c3aed", 1.6).set_attr("stroke-dasharray", "5 3");
scene.arrow(420.0, 190.0, 339.0, 154.0, "#7c3aed", 1.6);
scene.text(345.0, 215.0, 11.0, "back wall, +27 ms", "#6d28d9");
scene.text(230.0, 290.0, 11.5, "after ~50 ms reflections overlap into a diffuse, exponentially decaying tail", "#475569").set_attr("text-anchor", "middle");
scene.render_png("build/rendered/conv_room.png", 460, 300, 2);
end _dsl_
savedsl(d, "build/convolution_reverb_rt60-diagram.dslb");
r2 = system ${dsl_cli(d)} --dsl build/convolution_reverb_rt60-diagram.dslb;
if (r2.code != 0) { println(r2.stderr); }
assert(r2.code == 0);

p = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/convolution_reverb_rt60.png", 980, 720);
plot.cmd("set encoding utf8");
plot.cmd("set datafile separator ','");
plot.cmd("set multiplot");
plot.cmd("set label 99 'Convolution reverb: a 1.4 s hall, measured with the Schroeder curve, applied to a dry guitar' at screen 0.5, 0.97 center font ',13.5'");
plot.cmd("set pixmap 1 'build/rendered/conv_room.png' at screen 0.015, 0.49 width screen 0.45");

plot.script("set lmargin at screen 0.57\nset rmargin at screen 0.97\nset tmargin at screen 0.88\nset bmargin at screen 0.57");
plot.cmd("set title 'Impulse response: first 300 ms' font ',11'");
plot.cmd("set xlabel 'time (ms)'; set ylabel 'amplitude'; set xrange [-6:300]; set yrange [-0.4:1.1]; set grid lc rgb '#e2e8f0'");
plot.cmd("set label 1 'direct' at 4, 1.0 font ',9.5'");
plot.cmd("set label 2 'early reflections' at 46, 0.5 font ',9.5' tc rgb '#b45309'");
plot.cmd("set label 3 'diffuse tail' at 120, 0.2 font ',9.5' tc rgb '#475569'");
plot.cmd("plot 'build/conv_ir_early.csv' u ($1*1000):2 w l lw 1 lc rgb '#334155' notitle");
plot.cmd("unset label 1; unset label 2; unset label 3; unset pixmap 1");

plot.script("set lmargin at screen 0.08\nset rmargin at screen 0.47\nset tmargin at screen 0.42\nset bmargin at screen 0.09");
plot.cmd("set title 'Schroeder decay curve and T30 fit' font ',11'");
plot.cmd("set xlabel 'time (s)'; set ylabel 'energy remaining (dB)'; set xrange [0:2.4]; set yrange [-80:2]; set ytics 10");
plot.cmd("set key top right font ',9.5' opaque box lc rgb '#cbd5e1'");
plot.cmd("load 'build/conv_fit.gp'");
plot.cmd("set arrow 1 from graph 0, first -5 to graph 1, first -5 nohead dt 3 lc rgb '#94a3b8'");
plot.cmd("set arrow 2 from graph 0, first -35 to graph 1, first -35 nohead dt 3 lc rgb '#94a3b8'");
plot.cmd("plot 'build/conv_edc.csv' u 1:2 w l lw 2.5 lc rgb '#2563eb' t 'Schroeder curve', (x >= t5 && x <= t5 + rt/2) ? -5 - 60*(x - t5)/rt : 1/0 w l lw 2 dt 2 lc rgb '#dc2626' t sprintf('T30 fit: RT60 = %.2f s', rt)");
plot.cmd("unset arrow 1; unset arrow 2");

plot.script("set lmargin at screen 0.57\nset rmargin at screen 0.89\nset tmargin at screen 0.42\nset bmargin at screen 0.09");
plot.cmd("set title 'Guitar phrase in the hall (dry ends at 1.5 s)' font ',11'");
plot.cmd("set xlabel 'time (s)'; set ylabel 'frequency (Hz)'; set xrange [0:2.5]; set yrange [0:5000]; set ytics 1000; set cbrange [-80:0]; set cblabel 'dB'");
plot.cmd("set pm3d map; set palette defined (0 '#0b1026', 0.35 '#253494', 0.6 '#41b6c4', 0.85 '#fed976', 1 '#ffffcc')");
plot.cmd("set arrow 3 from 1.5, 0 to 1.5, 5000 nohead front dt 2 lw 1.5 lc rgb '#ffffff'");
plot.cmd("splot 'build/conv_wet_sg.csv' u 1:2:3 notitle");
plot.cmd("unset multiplot");
plot.close();
end _dsl_
savedsl(p, "build/convolution_reverb_rt60-plot.dslb");
r3 = system ${dsl_cli(p)} --dsl build/convolution_reverb_rt60-plot.dslb;
if (r3.code != 0) { println(r3.stderr); }
assert(r3.code == 0);
println("wrote images/convolution_reverb_rt60.png and audio/convolution_reverb_rt60.wav");
