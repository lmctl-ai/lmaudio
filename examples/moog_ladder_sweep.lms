# Huovilainen Nonlinear 24 dB/octave Moog Ladder Filter (DaisySP LadderFilter):
# exponential cutoff sweep (150 Hz -> 4200 Hz) with resonant peak on a dual-sawtooth bass drone.
mkdir("build");
mkdir("audio");
mkdir("images");

a = _dsl_ cli="lmaudio" install="github:lmctl-ai/lmaudio@latest";
let sr = 22050;
let dur = 2.8;

# Dual detuned sawtooth bass (A1 = 55 Hz + A2 = 110 Hz)
let raw_bass = audio.saw(55.0, dur, 0.45, sr)
  .mix(audio.saw(55.35, dur, 0.40, sr))
  .mix(audio.saw(110.0, dur, 0.35, sr));

# Sweep ladder cutoff exponentially from 140 Hz to 4200 Hz with high resonance (res = 0.72)
let swept = raw_bass.lpf_sweep(140.0, 4200.0, 0.72).fade(0.03, 0.08).normalize(0.92);

# Verify spectral centroid increases monotonically from start -> middle -> end of sweep
let c_start = swept.slice(0.1, 0.6).centroid();
let c_mid = swept.slice(1.1, 1.6).centroid();
let c_end = swept.slice(2.1, 2.6).centroid();
if (c_mid <= c_start) { audio.assert_close(c_mid, c_start, 0.0); }
if (c_end <= c_mid) { audio.assert_close(c_end, c_mid, 0.0); }

swept.save_wav("audio/moog_ladder_sweep.wav", 16);
swept.spectrogram(512, 128, "hann", 5000.0).save_csv("build/moog_sweep_sgram.csv", -80.0);

# Static ladder filter snapshots at fc = 350 Hz, 1000 Hz, and 2800 Hz for spectral comparison
raw_bass.slice(0.0, 0.5).ladder(350.0, 0.72, 1.2, "lp24").spectrum("hann", 4096).save_csv("build/moog_fc350.csv", 4500.0);
raw_bass.slice(0.0, 0.5).ladder(1000.0, 0.72, 1.2, "lp24").spectrum("hann", 4096).save_csv("build/moog_fc1000.csv", 4500.0);
raw_bass.slice(0.0, 0.5).ladder(2800.0, 0.72, 1.2, "lp24").spectrum("hann", 4096).save_csv("build/moog_fc2800.csv", 4500.0);
end _dsl_
savedsl(a, "build/moog_ladder_sweep.dslb");
r1 = system ${dsl_cli(a)} --dsl build/moog_ladder_sweep.dslb;
assert(r1.code == 0);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/moog_ladder_sweep.png", 980, 660);
plot.cmd("set datafile separator ','");
plot.cmd("set multiplot layout 2,1 title 'Huovilainen 24 dB/oct Moog Ladder Filter Sweep (fc = 140 Hz -> 4200 Hz, Q = 0.72)' font ',13'");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#e0e0e0'");

plot.cmd("set title 'STFT Spectrogram of Resonant Cutoff Sweep Over Sawtooth Harmonic Comb'; set xlabel 'Time (s)'; set ylabel 'Frequency (Hz)'");
plot.cmd("set xrange [0:2.75]; set yrange [0:4500]; set cbrange [-75:-5]; set cblabel 'dB'");
plot.cmd("set pm3d map; set palette defined (0 '#0a0720', 0.25 '#2c115f', 0.5 '#721f81', 0.75 '#f1605d', 0.9 '#feb078', 1 '#fcfdbf')");
plot.cmd("splot 'build/moog_sweep_sgram.csv' u 1:2:3 notitle");

plot.cmd("unset pm3d; set border 3; set tics nomirror; set grid lc rgb '#e0e0e0'");
plot.cmd("set title 'Spectral Snapshots Showing 24 dB/oct Roll-Off and Resonant Peak at Cutoff fc'; set xlabel 'Frequency (Hz)'; set ylabel 'Magnitude (dB)'");
plot.cmd("set xrange [0:4200]; set yrange [-75:0]; set key top right box opaque");
plot.cmd("plot 'build/moog_fc350.csv' u 1:3 w l lw 1.8 lc rgb '#1f77b4' title 'fc = 350 Hz', 'build/moog_fc1000.csv' u 1:3 w l lw 1.8 lc rgb '#2ca02c' title 'fc = 1000 Hz', 'build/moog_fc2800.csv' u 1:3 w l lw 1.8 lc rgb '#d62728' title 'fc = 2800 Hz'");

plot.cmd("unset multiplot");
plot.close();
end _dsl_
savedsl(draw, "build/moog_ladder_sweep-draw.dslb");
r2 = system ${dsl_cli(draw)} --dsl build/moog_ladder_sweep-draw.dslb;
assert(r2.code == 0);
print("wrote images/moog_ladder_sweep.png and audio/moog_ladder_sweep.wav");
