# Band-limited PolyBLEP oscillators (Sine, Triangle, Square, Sawtooth at A4 = 440 Hz):
# time-domain waveforms, Fourier harmonic series spectra, and sequential 4-voice audio showcase.
mkdir("build");
mkdir("audio");
mkdir("images");

a = _lmcode_ cli="lmaudio" install="github:lmctl-ai/lmaudio@latest" out="build/polyblep_harmonics.dslb";
let sr = 22050;
let f0 = 440.0;

let w_sin = audio.sine(f0, 0.65, 0.8, sr);
let w_tri = audio.triangle(f0, 0.65, 0.8, sr);
let w_sqr = audio.square(f0, 0.65, 0.8, 0.5, sr);
let w_saw = audio.saw(f0, 0.65, 0.8, sr);

# Verify fundamental pitch of all 4 oscillator waveforms
audio.assert_close(w_sin.pitch(), 440.0, 0.5);
audio.assert_close(w_tri.pitch(), 440.0, 1.0);
audio.assert_close(w_sqr.pitch(), 440.0, 1.0);
audio.assert_close(w_saw.pitch(), 440.0, 1.0);

# Export 3 cycles (6.82 ms) at 44.1 kHz for crisp waveform plots
audio.sine(f0, 0.007, 0.8, 44100).save_csv("build/pb_sin_wave.csv");
audio.triangle(f0, 0.007, 0.8, 44100).save_csv("build/pb_tri_wave.csv");
audio.square(f0, 0.007, 0.8, 0.5, 44100).save_csv("build/pb_sqr_wave.csv");
audio.saw(f0, 0.007, 0.8, 44100).save_csv("build/pb_saw_wave.csv");

# Export FFT magnitude spectra up to 5000 Hz
w_sin.spectrum("hann", 8192).save_csv("build/pb_sin_spec.csv", 5000.0);
w_tri.spectrum("hann", 8192).save_csv("build/pb_tri_spec.csv", 5000.0);
w_sqr.spectrum("hann", 8192).save_csv("build/pb_sqr_spec.csv", 5000.0);
w_saw.spectrum("hann", 8192).save_csv("build/pb_saw_spec.csv", 5000.0);

# Concatenate with smooth ADSR envelopes into playable showcase WAV (2.6 s, 115 KB)
let showcase = w_sin.adsr(0.02, 0.08, 0.8, 0.08)
  .concat(w_tri.adsr(0.02, 0.08, 0.8, 0.08))
  .concat(w_sqr.adsr(0.02, 0.08, 0.75, 0.08))
  .concat(w_saw.adsr(0.02, 0.08, 0.75, 0.08))
  .normalize(0.92);
showcase.save_wav("audio/polyblep_harmonics.wav", 16);
end _lmcode_

r1 = system ${"lmaudio"} --lmcode build/polyblep_harmonics.dslb;
assert(r1.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest" out="build/polyblep_harmonics-draw.dslb";
plot.png("images/polyblep_harmonics.png", 980, 660);
plot.cmd("set datafile separator ','");
plot.cmd("set multiplot layout 2,2 title 'Band-Limited PolyBLEP Oscillators at A4 = 440 Hz: Waveforms and Fourier Harmonics' font ',13'");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#e0e0e0'");

plot.cmd("set title 'Sine and Triangle Waveforms (3 Cycles)'; set xlabel 'Time (ms)'; set ylabel 'Amplitude'");
plot.cmd("set xrange [0:6.8]; set yrange [-1.05:1.05]; set key top right box opaque");
plot.cmd("plot 'build/pb_sin_wave.csv' u ($1*1000):2 w l lw 2.2 lc rgb '#1f77b4' title 'Sine (f0)', 'build/pb_tri_wave.csv' u ($1*1000):2 w l lw 2.0 lc rgb '#2ca02c' title 'Triangle (odd 1/n^2)'");

plot.cmd("set title 'PolyBLEP Square and Sawtooth Waveforms (3 Cycles)'; set xlabel 'Time (ms)'; set ylabel 'Amplitude'");
plot.cmd("plot 'build/pb_sqr_wave.csv' u ($1*1000):2 w l lw 2.0 lc rgb '#ff7f0e' title 'PolyBLEP Square (odd 1/n)', 'build/pb_saw_wave.csv' u ($1*1000):2 w l lw 2.0 lc rgb '#d62728' title 'PolyBLEP Saw (all 1/n)'");

plot.cmd("set title 'Sine and Triangle Magnitude Spectra'; set xlabel 'Frequency (Hz)'; set ylabel 'Magnitude (dB)'");
plot.cmd("set xrange [0:4800]; set xtics 1000; set yrange [-80:5]; set key top right box opaque");
plot.cmd("plot 'build/pb_tri_spec.csv' u 1:3 w l lw 1.6 lc rgb '#2ca02c' title 'Triangle Harmonics', 'build/pb_sin_spec.csv' u 1:3 w l lw 2.0 lc rgb '#1f77b4' title 'Pure Sine (440 Hz)'");

plot.cmd("set title 'PolyBLEP Square and Sawtooth Harmonics'; set xlabel 'Frequency (Hz)'; set ylabel 'Magnitude (dB)'");
plot.cmd("plot 'build/pb_saw_spec.csv' u 1:3 w l lw 1.5 lc rgb '#d62728' title 'Sawtooth (all k*440 Hz)', 'build/pb_sqr_spec.csv' u 1:3 w l lw 1.6 lc rgb '#ff7f0e' title 'Square ((2k+1)*440 Hz)'");

plot.cmd("unset multiplot");
plot.close();
end _lmcode_

r2 = system ${"lmplot"} --lmcode build/polyblep_harmonics-draw.dslb;
assert(r2.code == 0);
print("wrote images/polyblep_harmonics.png and audio/polyblep_harmonics.wav");
