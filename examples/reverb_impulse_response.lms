# Algorithmic reverb: what RT60 does a feedback delay network really give you?
# Buffer.zitarev(rt60_low, rt60_mid, damping_hz, wet) is an 8-line feedback delay network
# (Householder mixing, two-band decay, HF damping; MIT clean-room, not zita-rev1 code). An impulse
# through it is the room's impulse response. Three settings (room, hall, cathedral) are measured
# with the Schroeder backward integral and a T30 fit (Buffer.rt60): the broadband RT60 lands
# within about 6 % of the mid-band setting, a little short because the HF damping makes the
# treble die sooner (the spectrogram shows it). Asserted: each within 10 %, in the right order.
mkdir("build");
mkdir("audio");
mkdir("images");

a = _lmcode_ cli="lmaudio" install="github:lmctl-ai/lmaudio@latest";
let sr = 22050;

# Unit impulse padded to 4 s to capture the full reverberant impulse response h(t).
let imp = audio.impulse(4.0, 0.005, 1.0, sr);
let ir_room = imp.zitarev(0.55, 0.45, 4500.0, 1.0).normalize(0.9);
let ir_hall = imp.zitarev(1.60, 1.25, 6000.0, 1.0).normalize(0.9);
let ir_cath = imp.zitarev(3.20, 2.50, 7500.0, 1.0).normalize(0.9);
let rt_room = ir_room.rt60();
let rt_hall = ir_hall.rt60();
let rt_cath = ir_cath.rt60();
audio.print("measured broadband RT60 (T30): room " + str(rt_room) + " s, hall " + str(rt_hall) + " s, cathedral " + str(rt_cath) + " s (mid-band settings 0.45, 1.25, 2.5 s)");
audio.assert_close(rt_room, 0.45, 0.1 * 0.45);
audio.assert_close(rt_hall, 1.25, 0.1 * 1.25);
audio.assert_close(rt_cath, 2.5, 0.1 * 2.5);
audio.assert_close(min(rt_room, rt_hall), rt_room, 0.0);
audio.assert_close(min(rt_hall, rt_cath), rt_hall, 0.0);
ir_room.schroeder_db().save_csv("build/ir_room_edc.csv", 1500);
ir_hall.schroeder_db().save_csv("build/ir_hall_edc.csv", 1500);
ir_cath.schroeder_db().save_csv("build/ir_cath_edc.csv", 1500);
audio.save_text("build/ir_rt.gp", "rt_room = " + str(rt_room) + "; rt_hall = " + str(rt_hall) + "; rt_cath = " + str(rt_cath) + "\n");

ir_hall.slice(0.0, 1.6).save_csv("build/ir_hall_wave.csv", 1800);

# STFT spectrogram of Concert Hall impulse response showing faster HF absorption than LF decay
let sg_hall = ir_hall.slice(0.0, 1.6).spectrogram(256, 64, "hann", 8000.0);
sg_hall.save_csv("build/ir_hall_sgram.csv", -75.0);

# Compare early (0..0.25 s) vs late (0.6..1.4 s) spectrum of the Hall IR
ir_hall.slice(0.01, 0.26).spectrum("hann", 4096).save_csv("build/ir_hall_early_spec.csv", 8000.0);
ir_hall.slice(0.55, 1.35).spectrum("hann", 4096).save_csv("build/ir_hall_late_spec.csv", 8000.0);

# Audible showcase: acoustic snare transient + plucked chord in Concert Hall reverb
let snare_hit = audio.drum("snare", 185.0, 0.35, 0.45, 0.55, 0.9, sr).pad(0.0, 1.15);
let hall_demo = snare_hit.zitarev(1.8, 1.3, 6200.0, 0.42).concat(
  audio.sequence("E4+G#4+B4+E5:0.4 R:1.4", 60.0, "pluck", sr).zitarev(2.6, 1.9, 6800.0, 0.50)
).normalize(0.92);
hall_demo.save_wav("audio/reverb_impulse_response.wav", 16);
end _lmcode_
savedsl(a, "build/reverb_impulse_response.dslb");
r1 = system ${dsl_cli(a)} --dsl build/reverb_impulse_response.dslb;
for (l in lines(r1.stdout)) { if (!starts_with(l, "{")) { println(l); } }
if (r1.code != 0) { println(r1.stderr); }
assert(r1.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/reverb_impulse_response.png", 980, 660);
plot.cmd("set datafile separator ','");
plot.cmd("load 'build/ir_rt.gp'");
plot.cmd("set multiplot layout 2,2 title '8-line feedback delay network reverb: impulse response and measured RT60' font ',13'");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#e0e0e0'");

plot.cmd("set title 'Hall impulse response h(t)' font ',11'; set xlabel 'Time (s)'; set ylabel 'Amplitude'");
plot.cmd("set xrange [0:1.6]; set yrange [-0.95:0.95]; unset key");
plot.cmd("plot 'build/ir_hall_wave.csv' u 1:2 w l lw 1.2 lc rgb '#1f77b4'");

plot.cmd("set title 'Schroeder decay curves (T30 fit between the dotted lines)' font ',11'; set xlabel 'Time (s)'; set ylabel 'Energy remaining (dB)'");
plot.cmd("set xrange [0:3.5]; set yrange [-70:2]; set key top right nobox font ',9.5'");
plot.cmd("set arrow 1 from graph 0, first -5 to graph 1, first -5 nohead dt 3 lc rgb '#94a3b8'; set arrow 2 from graph 0, first -35 to graph 1, first -35 nohead dt 3 lc rgb '#94a3b8'");
plot.cmd("plot 'build/ir_room_edc.csv' u 1:2 w l lw 2.4 lc rgb '#2ca02c' t sprintf('room: set 0.45 s, measured %.2f s', rt_room), 'build/ir_hall_edc.csv' u 1:2 w l lw 2.4 lc rgb '#1f77b4' t sprintf('hall: set 1.25 s, measured %.2f s', rt_hall), 'build/ir_cath_edc.csv' u 1:2 w l lw 2.4 lc rgb '#d62728' t sprintf('cathedral: set 2.5 s, measured %.2f s', rt_cath)");
plot.cmd("unset arrow 1; unset arrow 2");

plot.cmd("set title 'Hall IR spectrogram: treble decays first' font ',11'; set xlabel 'Time (s)'; set ylabel 'Frequency (Hz)'");
plot.cmd("set xrange [0:1.6]; set yrange [0:7500]; set cbrange [-70:0]; set cblabel 'dB'");
plot.cmd("set pm3d map; set palette defined (0 '#081d58', 0.25 '#225ea8', 0.5 '#41b6c4', 0.75 '#fed976', 1 '#bd0026')");
plot.cmd("splot 'build/ir_hall_sgram.csv' u 1:2:3 notitle");

plot.cmd("unset pm3d");
plot.cmd("set title 'Hall: early vs late spectrum' font ',11'; set xlabel 'Frequency (Hz)'; set ylabel 'Level (dB)'");
plot.cmd("set xrange [100:7500]; set yrange [-100:-20]; set key top right nobox font ',9.5'");
plot.cmd("plot 'build/ir_hall_early_spec.csv' u 1:3 w l lw 1.5 lc rgb '#1f77b4' t 'early part, 0-0.25 s (bright)', 'build/ir_hall_late_spec.csv' u 1:3 w l lw 1.5 lc rgb '#9467bd' t 'late tail, 0.55-1.35 s (treble gone)'");

plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(draw, "build/reverb_impulse_response-draw.dslb");
r2 = system ${dsl_cli(draw)} --dsl build/reverb_impulse_response-draw.dslb;
assert(r2.code == 0);
print("wrote images/reverb_impulse_response.png and audio/reverb_impulse_response.wav");
