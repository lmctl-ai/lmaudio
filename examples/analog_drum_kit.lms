# 808 Analog & Synthetic Drum Synthesis (DaisySP AnalogBassDrum, AnalogSnareDrum, HiHat):
# transient waveforms, spectral envelopes, and a 2-bar electronic breakbeat groove.
mkdir("build");
mkdir("audio");
mkdir("images");

a = _dsl_ cli="lmaudio" install="github:lmctl-ai/lmaudio@latest";
let sr = 22050;

let kick = audio.drum("kick", 55.0, 0.35, 0.65, 0.55, 0.90, sr).normalize(0.95);
let snare = audio.drum("snare", 185.0, 0.35, 0.50, 0.65, 0.90, sr).normalize(0.90);
let hat_c = audio.drum("hihat", 3500.0, 0.15, 0.20, 0.75, 0.75, sr).normalize(0.65);
let hat_o = audio.drum("hihat", 3500.0, 0.32, 0.75, 0.75, 0.85, sr).normalize(0.75);

# Verify spectral centroid ordering: hihat > snare > kick
if (hat_c.centroid() <= snare.centroid()) { audio.assert_close(hat_c.centroid(), snare.centroid(), 0.0); }
if (snare.centroid() <= kick.centroid()) { audio.assert_close(snare.centroid(), kick.centroid(), 0.0); }

kick.slice(0.0, 0.18).save_csv("build/drum_kick_wave.csv");
snare.slice(0.0, 0.18).save_csv("build/drum_snare_wave.csv");
hat_o.slice(0.0, 0.18).save_csv("build/drum_hat_wave.csv");

kick.spectrum("hann", 4096).save_csv("build/drum_kick_spec.csv", 6000.0);
snare.spectrum("hann", 4096).save_csv("build/drum_snare_spec.csv", 6000.0);
hat_o.spectrum("hann", 4096).save_csv("build/drum_hat_spec.csv", 6000.0);

# Assemble a 2-bar breakbeat pattern at 125 BPM (step = 0.12 s, 16 steps = 1.92 s, repeated = 3.2 s)
let step = 0.12;
let groove = audio.silence(sr, 3.1);
for (bar in range(0, 2)) {
  let b_off = float(bar) * 1.44;
  # Kick on steps 0, 3, 6, 8
  groove = groove.mix(kick, 0.95, b_off + 0.0 * step);
  groove = groove.mix(kick, 0.80, b_off + 3.0 * step);
  groove = groove.mix(kick, 0.85, b_off + 6.0 * step);
  groove = groove.mix(kick, 0.90, b_off + 8.0 * step);
  # Snare on steps 4 and 10
  groove = groove.mix(snare, 0.90, b_off + 4.0 * step);
  groove = groove.mix(snare, 0.92, b_off + 10.0 * step);
  # Hi-hats on every eighth/sixteenth
  for (s in range(0, 12)) {
    if (s == 5 || s == 11) {
      groove = groove.mix(hat_o, 0.55, b_off + float(s) * step);
    } else {
      groove = groove.mix(hat_c, 0.45, b_off + float(s) * step);
    }
  }
}
groove = groove.compress(3.0, -14.0, 0.005, 0.08, 3.0).normalize(0.92);
groove.save_wav("audio/analog_drum_kit.wav", 16);
groove.save_csv("build/drum_groove_wave.csv", 2000);
end _dsl_
savedsl(a, "build/analog_drum_kit.dslb");
r1 = system ${dsl_cli(a)} --dsl build/analog_drum_kit.dslb;
assert(r1.code == 0);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/analog_drum_kit.png", 980, 660);
plot.cmd("set datafile separator ','");
plot.cmd("set multiplot layout 2,2 title '808 Analog and Synthetic Drum Voices: Transients, Spectra and Breakbeat Groove' font ',13'");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#e0e0e0'");

plot.cmd("set title '808 Bass Drum Pitch-Swept Bridged-T Transient'; set xlabel 'Time (ms)'; set ylabel 'Amplitude'");
plot.cmd("set xrange [0:180]; set yrange [-1.05:1.05]; unset key");
plot.cmd("plot 'build/drum_kick_wave.csv' u ($1*1000):2 w l lw 1.8 lc rgb '#1f77b4'");

plot.cmd("set title 'Analog Snare and Metallic Hi-Hat Transients'; set xlabel 'Time (ms)'; set ylabel 'Amplitude'");
plot.cmd("set xrange [0:180]; set yrange [-1.05:1.05]; set key top right box opaque");
plot.cmd("plot 'build/drum_snare_wave.csv' u ($1*1000):2 w l lw 1.4 lc rgb '#ff7f0e' title 'Snare (Body + Noise)', 'build/drum_hat_wave.csv' u ($1*1000):2 w l lw 1.2 lc rgb '#2ca02c' title 'Open Hi-Hat'");

plot.cmd("set title 'Drum Spectral Envelopes (Sub-Bass vs Mid Snare vs Metallic Hat)'; set xlabel 'Frequency (Hz)'; set ylabel 'Magnitude (dB)'");
plot.cmd("set xrange [30:6000]; set logscale x; set yrange [-75:0]; set key bottom left box opaque");
plot.cmd("plot 'build/drum_kick_spec.csv' u 1:3 w l lw 2.0 lc rgb '#1f77b4' title '808 Kick (55 Hz Peak)', 'build/drum_snare_spec.csv' u 1:3 w l lw 1.6 lc rgb '#ff7f0e' title 'Snare (185 Hz + Broadband)', 'build/drum_hat_spec.csv' u 1:3 w l lw 1.5 lc rgb '#2ca02c' title 'Hi-Hat (High-Frequency Band)'");

plot.cmd("unset logscale x; set title '2-Bar Compressed Breakbeat Groove Waveform'; set xlabel 'Time (s)'; set ylabel 'Amplitude'");
plot.cmd("set xrange [0:3.0]; set yrange [-1.05:1.05]; unset key");
plot.cmd("plot 'build/drum_groove_wave.csv' u 1:2 w l lw 1.2 lc rgb '#9467bd'");

plot.cmd("unset multiplot");
plot.close();
end _dsl_
savedsl(draw, "build/analog_drum_kit-draw.dslb");
r2 = system ${dsl_cli(draw)} --dsl build/analog_drum_kit-draw.dslb;
assert(r2.code == 0);
print("wrote images/analog_drum_kit.png and audio/analog_drum_kit.wav");
