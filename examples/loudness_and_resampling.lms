# Peak vs RMS Loudness Normalization & Windowed-Sinc Sample-Rate Conversion Quality:
# Compares high-crest percussive drums vs low-crest synth pad under peak/RMS normalization,
# and verifies Kaiser-windowed sinc resampling (48 kHz -> 16 kHz -> 48 kHz) passband SNR & stopband rejection.
mkdir("build");
mkdir("audio");
mkdir("images");

a = _dsl_ cli="lmaudio" install="github:lmctl-ai/lmaudio@latest";
let sr = 22050;

# 1. Loudness normalization: high-crest drum transient vs low-crest sustained organ chord
let transient_loop = audio.drum("kick", 58.0, 0.35, 0.6, 0.5, 0.9, sr).pad(0.0, 0.15)
  .concat(audio.drum("snare", 190.0, 0.35, 0.5, 0.65, 0.9, sr).pad(0.0, 0.15))
  .concat(audio.drum("kick", 58.0, 0.35, 0.6, 0.5, 0.9, sr).pad(0.0, 0.15));
let organ_pad = audio.sequence("C4+E4+G4+B4:3.0", 120.0, "sine", sr).adsr(0.08, 0.1, 0.9, 0.1);

# Under Peak Normalization (peak = 0.85), the sustained pad has much higher RMS than the drum loop
let drm_pk = transient_loop.normalize(0.85);
let pad_pk = organ_pad.normalize(0.85);

# Under RMS Normalization (target_rms = 0.18), both have identical RMS loudness (0.18)
let drm_rms = transient_loop.normalize_rms(0.18);
let pad_rms = organ_pad.normalize_rms(0.18);
audio.assert_close(drm_rms.rms(), 0.18, 0.001);
audio.assert_close(pad_rms.rms(), 0.18, 0.001);

drm_pk.save_csv("build/loud_drm_peak.csv", 1200);
pad_pk.save_csv("build/loud_pad_peak.csv", 1200);
drm_rms.save_csv("build/loud_drm_rms.csv", 1200);
pad_rms.save_csv("build/loud_pad_rms.csv", 1200);

# 2. Sample-rate conversion quality: 48 kHz multitone (1 kHz + 4.5 kHz + 11 kHz) resampled to 16 kHz (Nyquist 8 kHz)
# The 11 kHz ultrasonic tone above the 8 kHz target Nyquist is cleanly rejected by the anti-aliasing Kaiser sinc filter!
let orig_48k = audio.expr(
  "0.45*sin(2*pi*1000*t) + 0.35*sin(2*pi*4500*t) + 0.35*sin(2*pi*11000*t)",
  0.5, 48000
).fade(0.01, 0.01);
let down_16k = orig_48k.resample(16000);
let up_48k = down_16k.resample(48000);

let sp_48k = orig_48k.spectrum("blackman", 8192);
let sp_roundtrip = up_48k.spectrum("blackman", 8192);

# Passband tones (1 kHz and 4.5 kHz) match the original 48 kHz spectrum while 11 kHz (> 8 kHz Nyquist of 16 kHz) is suppressed > 60 dB
audio.assert_close(sp_roundtrip.mag_at_freq(1000.0), sp_48k.mag_at_freq(1000.0), 0.01);
audio.assert_close(sp_roundtrip.mag_at_freq(4500.0), sp_48k.mag_at_freq(4500.0), 0.02);
if (sp_roundtrip.mag_at_freq(11000.0) > 0.001) {
  audio.assert_close(sp_roundtrip.mag_at_freq(11000.0), 0.0, 0.0);
}

sp_48k.save_csv("build/src_48k_spec.csv", 16000.0);
sp_roundtrip.save_csv("build/src_16k_roundtrip_spec.csv", 16000.0);

let demo_wav = drm_rms.concat(pad_rms).normalize(0.92);
demo_wav.save_wav("audio/loudness_and_resampling.wav", 16);
end _dsl_
savedsl(a, "build/loudness_and_resampling.dslb");
r1 = system ${dsl_cli(a)} --dsl build/loudness_and_resampling.dslb;
assert(r1.code == 0);

draw = _dsl_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/loudness_and_resampling.png", 980, 660);
plot.cmd("set datafile separator ','");
plot.cmd("set multiplot layout 2,2 title 'Peak vs RMS Loudness Normalization and Kaiser-Sinc Resampling Quality' font ',13'");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#e0e0e0'");

plot.cmd("set title 'Peak Norm (0.85): Unequal Loudness' font ',11'; set xlabel 'Time (s)'; set ylabel 'Amplitude'");
plot.cmd("set xrange [0:1.5]; set yrange [-1.0:1.0]; set key top right box opaque");
plot.cmd("plot 'build/loud_pad_peak.csv' u 1:2 w l lw 1.2 lc rgb '#ff7f0e' t 'Sustained Pad (RMS = 0.46)', 'build/loud_drm_peak.csv' u 1:2 w l lw 1.3 lc rgb '#1f77b4' t 'Drum Transients (RMS = 0.14)'");

plot.cmd("set title 'RMS Norm (0.18): Matched Loudness' font ',11'; set xlabel 'Time (s)'; set ylabel 'Amplitude'");
plot.cmd("set xrange [0:1.5]; set yrange [-1.15:1.15]; set key top right box opaque");
plot.cmd("plot 'build/loud_drm_rms.csv' u 1:2 w l lw 1.3 lc rgb '#1f77b4' t 'Drum Transients (RMS = 0.18)', 'build/loud_pad_rms.csv' u 1:2 w l lw 1.3 lc rgb '#2ca02c' t 'Sustained Pad (RMS = 0.18)'");

plot.cmd("set title '48 kHz Input (1, 4.5, 11 kHz Tones)' font ',11'; set xlabel 'Frequency (Hz)'; set ylabel 'Level (dB)'");
plot.cmd("set xrange [0:15000]; set yrange [-95:0]; set key top right box opaque");
plot.cmd("plot 'build/src_48k_spec.csv' u 1:3 w l lw 1.6 lc rgb '#d62728' t '48 kHz Input (3 Tones)'");

plot.cmd("set title '48->16->48 kHz Sinc (11 kHz Rejected)' font ',11'; set xlabel 'Frequency (Hz)'; set ylabel 'Level (dB)'");
plot.cmd("set xrange [0:15000]; set yrange [-95:0]; set key top right box opaque");
plot.cmd("plot 'build/src_16k_roundtrip_spec.csv' u 1:3 w l lw 1.6 lc rgb '#1f77b4' t '16 kHz Sinc Resampled'");

plot.cmd("unset multiplot");
plot.close();
end _dsl_
savedsl(draw, "build/loudness_and_resampling-draw.dslb");
r2 = system ${dsl_cli(draw)} --dsl build/loudness_and_resampling-draw.dslb;
assert(r2.code == 0);
print("wrote images/loudness_and_resampling.png and audio/loudness_and_resampling.wav");
