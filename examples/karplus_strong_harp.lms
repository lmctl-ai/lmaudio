# Plucked-string harp: DaisySP StringVoice (a Karplus-Strong-style string with a non-linear
# bridge and dispersion) through the MIT feedback-delay-network reverb (Buffer.reverb).
# Celtic harp arpeggio, damping decay comparison, and STFT spectrogram.
mkdir("build");
mkdir("audio");
mkdir("images");

a = _lmcode_ cli="lmaudio" install="github:lmctl-ai/lmaudio@latest";
let sr = 22050;

# Compare bright long-decay pluck vs warm damped pluck at A4 = 440 Hz
let pl_bright = audio.pluck(440.0, 0.8, 0.85, 0.85, 0.90, sr);
let pl_warm = audio.pluck(440.0, 0.8, 0.85, 0.30, 0.65, sr);
audio.assert_close(pl_bright.pitch(), 440.0, 3.0);
if (pl_bright.centroid() <= pl_warm.centroid()) {
  audio.assert_close(pl_bright.centroid(), pl_warm.centroid(), 0.0);
}
pl_bright.slice(0.0, 0.045).save_csv("build/ks_bright_attack.csv");
pl_warm.slice(0.0, 0.045).save_csv("build/ks_warm_attack.csv");

# Render a Celtic harp arpeggio and final chord through FDN reverb (3.0 s, 132 KB)
let arp = audio.sequence("C4:0.5 E4:0.5 G4:0.5 B4:0.5 C5:0.5 E5:0.5 G5:1.0 C4+G4+C5+E5:2.0", 120.0, "pluck", sr);
let harp = arp.reverb(0.82, 7000.0, 0.28).normalize(0.92);
harp.save_wav("audio/karplus_strong_harp.wav", 16);
harp.save_csv("build/ks_harp_wave.csv", 1800);
harp.spectrogram(512, 128, "hann", 4500.0).save_csv("build/ks_harp_sgram.csv", -80.0);
end _lmcode_
savedsl(a, "build/karplus_strong_harp.dslb");
r1 = system ${dsl_cli(a)} --dsl build/karplus_strong_harp.dslb;
assert(r1.code == 0);

draw = _lmcode_ cli="lmplot" install="github:lmctl-ai/lmplot@latest";
plot.png("images/karplus_strong_harp.png", 980, 660);
plot.cmd("set datafile separator ','");
plot.cmd("set multiplot layout 2,2 title 'Plucked-string harp: DaisySP StringVoice and FDN reverb' font ',13'");
plot.cmd("set border 3; set tics nomirror; set grid lc rgb '#e0e0e0'");

plot.cmd("set title 'Plucked A4 (440 Hz): first 45 ms'; set xlabel 'Time (ms)'; set ylabel 'Amplitude'");
plot.cmd("set xrange [0:45]; set yrange [-1.0:1.7]; set key top right nobox font ',9.5'");
plot.cmd("plot 'build/ks_bright_attack.csv' u ($1*1000):2 w l lw 1.6 lc rgb '#1f77b4' title 'Bright String (brightness=0.85)', 'build/ks_warm_attack.csv' u ($1*1000):2 w l lw 1.6 lc rgb '#ff7f0e' title 'Warm Damped (brightness=0.30)'");

plot.cmd("set title 'Harp arpeggio + chord, with reverb'; set xlabel 'Time (s)'; set ylabel 'Amplitude'");
plot.cmd("set xrange [0:3.0]; set yrange [-1.0:1.0]; unset key");
plot.cmd("plot 'build/ks_harp_wave.csv' u 1:2 w l lw 1.2 lc rgb '#2b5c8f'");

plot.cmd("set size 0.96, 0.46; set origin 0.02, 0.02");
plot.cmd("set title 'STFT Spectrogram of Harp Arpeggio (C4-E4-G4-B4-C5-E5-G5 + Cmaj7 Chord)'; set xlabel 'Time (s)'; set ylabel 'Frequency (Hz)'");
plot.cmd("set xrange [0:3.0]; set yrange [0:4200]; set cbrange [-75:-5]; set cblabel 'dB'");
plot.cmd("set pm3d map; set palette defined (0 '#0d0829', 0.25 '#2b1e63', 0.5 '#1f77b4', 0.75 '#2ca02c', 0.9 '#ffbf00', 1 '#ffffcc')");
plot.cmd("splot 'build/ks_harp_sgram.csv' u 1:2:3 notitle");

plot.cmd("unset multiplot");
plot.close();
end _lmcode_
savedsl(draw, "build/karplus_strong_harp-draw.dslb");
r2 = system ${dsl_cli(draw)} --dsl build/karplus_strong_harp-draw.dslb;
assert(r2.code == 0);
print("wrote images/karplus_strong_harp.png and audio/karplus_strong_harp.wav");
